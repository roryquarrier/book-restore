---
import Base from '../layouts/Base.astro';
---

<Base>
<!-- GRAIN OVERLAY -->
<div class="grain-overlay"></div>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="nav-brand">BookBash</a>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/auth">Sign In</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">The Restoration Catalogue</p>
      <h1>Clean copies of any book.</h1>
      <p class="hero-sub">For busy teachers — sign up, add credits, drop the book in, get a clean copy out.</p>
      <div class="hero-ctas">
        <a href="/auth" class="btn-primary">Get Clean Copy</a>
        <a href="#how" class="btn-secondary">See How It Works</a>
      </div>
    </div>
    <div class="hero-image-wrap">
      <div class="ba-slider" id="baSlider" data-pos="0">
        <div class="ba-frame">
          <div class="ba-window">
            <!-- BOTTOM layer: degraded (BEFORE) — shows through on the RIGHT -->
            <img class="ba-img ba-img--degraded" src="/images/hero.png" alt="Peter Rabbit book cover — degraded photocopy, before restoration" draggable="false" />
            <!-- TOP layer: clean (AFTER) — shows on the LEFT, wiped by the divider -->
            <img class="ba-img ba-img--clean" src="/images/hero.png" alt="Peter Rabbit book cover — restored, after restoration" draggable="false" style="clip-path: inset(0 100% 0 0);" />
            <button class="ba-divider" type="button" role="slider" aria-label="Drag to compare before and after restoration" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0" style="left: 0%;">
              <span class="ba-handle" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 4 12 9 18"></polyline><polyline points="15 6 20 12 15 18"></polyline></svg>
              </span>
            </button>
          </div>
        </div>
      </div>
      <p class="caption">Source: photocopy, c. 1995 — Restored: 2026 · drag to compare</p>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="steps" id="how">
  <div class="steps-inner">
    <p class="section-label">II · The Method</p>
    <h2>Three steps, one clean copy.</h2>
    <p class="steps-intro">Every restoration follows the same procedure. You bring the worn original; we return a copy fit for the classroom.</p>
    <div class="step-list">
      <div class="step">
        <span class="step-num">01</span>
        <div>
          <h3>Upload</h3>
          <p>Drop in a photo, a scan, or a PDF — up to 80 pages at once. The page arrives as it is: smudged, crooked, faded.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-num">02</span>
        <div>
          <h3>We Restore</h3>
          <p>Book Bash reads the page, lifts the grey background, rebuilds the letterforms, and sharpens every line. 20–90 seconds per page.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-num">03</span>
        <div>
          <h3>Download</h3>
          <p>Get your clean copy as a print-ready PDF. Hand it out knowing every child can read every word.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BEFORE / AFTER -->
<section class="compare">
  <p class="section-label">III–IV · Condition Report</p>
  <h2>The same page, twice.</h2>
  <p class="compare-intro">Left: a fifth-generation photocopy from the staffroom cabinet. Right: the page Book Bash returns.</p>
  <div class="compare-grid">
    <figure class="fig-before">
      <span class="fig-tag">Fig. A — Before</span>
      <div class="plate-frame">
        <div class="plate-window">
          <img src="/images/before.png" alt="Degraded Peter Rabbit grammar exercise photocopy" />
        </div>
      </div>
      <figcaption>Source: classroom photocopy, fifth generation — 2026</figcaption>
    </figure>
    <figure class="fig-after">
      <span class="fig-tag">Fig. B — After</span>
      <div class="plate-frame">
        <div class="plate-window">
          <img src="/images/after.png" alt="Restored Peter Rabbit grammar exercise page" />
        </div>
      </div>
      <figcaption>Source: Book Bash restoration — 2026</figcaption>
    </figure>
  </div>
</section>

<!-- VALUE PROPS -->
<section class="values">
  <div class="values-inner">
    <p class="section-label">V · Why It Matters</p>
    <div class="claims-grid">
      <article class="claim">
        <span class="claim-num">01</span>
        <h3>Legible again, for every child in the room.</h3>
        <p>Grey pages and broken letters slow young readers down. A restored copy gives a class of thirty the same crisp page the first owner held.</p>
      </article>
      <article class="claim">
        <span class="claim-num">02</span>
        <h3>Nothing is lost.</h3>
        <p>Your layout, your page numbers, your exercise structure — nothing moves. We clean what's there; we don't redesign your lesson.</p>
      </article>
      <article class="claim">
        <span class="claim-num">03</span>
        <h3>Minutes, not evenings.</h3>
        <p>What used to mean an hour in Photoshop or a trip to the print shop now takes less time than making coffee.</p>
      </article>
    </div>
  </div>
</section>

<!-- PRICING + CTA (combined section, properly balanced) -->
<section class="pricing-cta" id="start">
  <div class="pricing-cta-inner">
    <p class="section-label">Terms of Acquisition</p>
    <p class="pricing-line"><strong>$5</strong>Credit-based. Starts at $5 for 50 pages.</p>
    <h2 class="pricing-cta-heading">Your library, returned to first-edition clarity.</h2>
    <a href="/auth" class="btn-primary">Get Clean Copy</a>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <span>Book Bash — Clean copies of any book.</span>
  <a href="#how">Back to top</a>
</footer>
</Base>

<style>
/* GRAIN */
.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; z-index: 9999;
  opacity: var(--tv-grade-grain);
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='2' stitchTiles='stitch'/%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E");
}

/* NAV */
.nav {
  display: flex; justify-content: space-between; align-items: baseline;
  flex-wrap: wrap; gap: calc(var(--tv-space-unit) * 2);
  padding: calc(var(--tv-space-unit) * 4);
  max-width: 72rem; margin: 0 auto;
}
@media (min-width: 700px) { .nav { padding: calc(var(--tv-space-unit) * 5) calc(var(--tv-space-unit) * 6); } }
.nav-brand {
  font-family: var(--tv-font-heading); font-weight: 700; font-size: 1.35rem;
  color: var(--tv-accent-2);
}
.nav-links { display: flex; gap: calc(var(--tv-space-unit) * 5); }
.nav-links a {
  font-family: var(--tv-font-mono); font-weight: 500; font-size: 0.8rem;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--tv-fg-muted);
  transition: color 0.2s ease;
}
.nav-links a:hover { color: var(--tv-accent); }
.nav-links a:focus-visible { outline: 2px solid var(--tv-accent); outline-offset: 4px; }

/* HERO */
.hero { padding: calc(var(--tv-space-unit) * 10) calc(var(--tv-space-unit) * 4); max-width: 72rem; margin: 0 auto; }
@media (min-width: 700px) { .hero { padding-inline: calc(var(--tv-space-unit) * 6); } }


.hero-grid { display: grid; grid-template-columns: 1fr; gap: calc(var(--tv-space-unit) * 10); align-items: center; }
@media (min-width: 900px) {
  .hero-grid { grid-template-columns: 7fr 5fr; gap: calc(var(--tv-space-unit) * 10); }
}

/* Text column: hold a comfortable measure and sit centred in its track */
.hero-copy { max-width: 34rem; }
@media (min-width: 900px) {
  .hero-copy { margin-inline: auto; padding-inline: calc(var(--tv-space-unit) * 2); }
}

.eyebrow {
  font-family: var(--tv-font-mono); font-size: 0.75rem; letter-spacing: 0.15em;
  text-transform: uppercase; color: var(--tv-accent-2); margin-bottom: calc(var(--tv-space-unit) * 4);
}
.hero h1 {
  font-family: var(--tv-font-heading); font-size: var(--tv-h1-size);
  font-weight: var(--tv-h1-weight); letter-spacing: var(--tv-h1-tracking);
  line-height: var(--tv-h1-leading); margin-bottom: calc(var(--tv-space-unit) * 5); max-width: 18ch;
}
.hero-sub {
  font-size: 1.2rem; line-height: 1.6; color: var(--tv-fg-muted);
  margin-bottom: calc(var(--tv-space-unit) * 6); max-width: 38ch;
}
.hero-ctas { display: flex; flex-direction: column; gap: calc(var(--tv-space-unit) * 3); }
@media (min-width: 480px) { .hero-ctas { flex-direction: row; align-items: center; } }

.btn-primary {
  display: inline-block; font-family: var(--tv-font-heading); font-weight: 600; font-size: 1.05rem;
  padding: calc(var(--tv-space-unit) * 3) calc(var(--tv-space-unit) * 7);
  background: var(--tv-accent); color: var(--tv-bg); border: none; border-radius: var(--tv-radius); cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: var(--tv-shadow-lift); }
.btn-primary:active { transform: translateY(0); }
.btn-primary:focus-visible { outline: 3px solid var(--tv-accent-2); outline-offset: 3px; }

.btn-secondary {
  display: inline-block; font-family: var(--tv-font-heading); font-weight: 500; font-size: 1.05rem;
  padding: calc(var(--tv-space-unit) * 3) 0; border-bottom: 2px solid var(--tv-accent);
}
.btn-secondary:hover { color: var(--tv-accent); }
.btn-secondary:focus-visible { outline: 2px solid var(--tv-accent); outline-offset: 4px; }


.hero-image-wrap { text-align: center; }

/* ─────────────────────────────────────────────────────────────
   BEFORE / AFTER WIPE SLIDER (hero)
   Uses its own .ba-* classnames so it NEVER touches the shared
   .plate-window img selector (which the compare section below
   relies on). Two stacked images + clip-path on the top layer.
   ───────────────────────────────────────────────────────────── */
.ba-slider {
  display: block;
  margin: 0 auto;
  max-width: min(38vh, 27rem);
  width: 100%;
  touch-action: none;                /* let pointermove drive dragging, not the browser scroll */
  -webkit-user-select: none;
  user-select: none;
}
.ba-frame {
  display: block;
  border: var(--tv-border-width) solid var(--tv-border);
  padding: calc(var(--tv-space-unit) * 3);
  background: var(--tv-surface);
}
.ba-window {
  display: block;
  position: relative;
  overflow: hidden;
  width: 100%;
  line-height: 0;                    /* kill inline-img gap */
}
.ba-img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
  pointer-events: none;              /* clicks go to the divider/drag surface */
}
/* BOTTOM layer: degraded BEFORE state — same look as the old hero */
.ba-img--degraded {
  filter: blur(1.6px) contrast(0.78) brightness(0.93) saturate(0.55) sepia(0.45);
  transform: skewX(-0.5deg);
}
/* TOP layer: clean AFTER state — subtle pop, clipped from the right by JS */
.ba-img--clean {
  position: absolute;
  top: 0; left: 0;
  filter: var(--tv-hero-filter);
  transform: skewX(0);
  /* clip-path is set inline on the element and updated by JS */
  transition: clip-path 0s;          /* JS animates via rAF; no CSS easing */
  will-change: clip-path;
}

/* labels */
.ba-label {
  position: absolute;
  top: calc(var(--tv-space-unit) * 2);
  font-family: var(--tv-font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 3px calc(var(--tv-space-unit) * 2);
  background: oklch(0.18 0.02 260 / 0.62);
  color: #fff;
  border-radius: var(--tv-radius);
  pointer-events: none;
  z-index: 3;
  line-height: 1.4;
}
.ba-label--after  { left:  calc(var(--tv-space-unit) * 2); }
.ba-label--before { right: calc(var(--tv-space-unit) * 2); }

/* divider + handle */
.ba-divider {
  position: absolute;
  top: 0; bottom: 0;
  width: 2px;
  margin-left: -1px;                 /* centre on the position */
  background: var(--tv-accent);
  border: 0;
  padding: 0;
  cursor: ew-resize;
  z-index: 4;
  touch-action: none;
  /* left:0% is set inline by JS */
  -webkit-tap-highlight-color: transparent;
}
.ba-divider:focus-visible {
  outline: 2px solid var(--tv-accent-2);
  outline-offset: 4px;
}
.ba-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44px; height: 44px;
  border-radius: 50%;
  display: grid; place-items: center;
  background: var(--tv-accent);
  color: var(--tv-bg);
  box-shadow: var(--tv-shadow-lift);
  transition: transform 0.15s ease;
}
.ba-divider:hover .ba-handle { transform: translate(-50%, -50%) scale(1.08); }
.ba-divider:active .ba-handle { transform: translate(-50%, -50%) scale(0.96); }

.caption {
  font-family: var(--tv-font-mono); font-size: 0.75rem; letter-spacing: 0.08em;
  color: var(--tv-fg-muted); text-align: center; margin-top: calc(var(--tv-space-unit) * 2);
}

/* SECTIONS */
.section-label {
  font-family: var(--tv-font-mono); font-size: 0.75rem; letter-spacing: 0.15em;
  text-transform: uppercase; color: var(--tv-fg-muted); margin-bottom: calc(var(--tv-space-unit) * 3);
}

/* HOW IT WORKS */
.steps { padding: calc(var(--tv-space-unit) * 16) calc(var(--tv-space-unit) * 4); background: var(--tv-surface); border-top: var(--tv-border-width) solid var(--tv-border); }
.steps-inner { max-width: 72rem; margin: 0 auto; }
.steps h2 { font-family: var(--tv-font-heading); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: calc(var(--tv-space-unit) * 4); }
.steps-intro { color: var(--tv-fg-muted); max-width: 42ch; margin: 0 0 calc(var(--tv-space-unit) * 10); }
.step-list { }
.step { display: grid; grid-template-columns: 1fr; gap: calc(var(--tv-space-unit) * 4); padding: calc(var(--tv-space-unit) * 6) 0; border-bottom: var(--tv-border-width) solid var(--tv-border); }
.step:last-child { border-bottom: none; }
@media (min-width: 700px) { .step { grid-template-columns: auto 1fr; gap: calc(var(--tv-space-unit) * 8); align-items: start; } }
.step-num { font-family: var(--tv-font-mono); font-size: 2.5rem; font-weight: 300; color: var(--tv-accent); line-height: 1; }
.step h3 { font-family: var(--tv-font-heading); font-size: 1.4rem; font-weight: 600; margin-bottom: calc(var(--tv-space-unit) * 2); }
.step p { color: var(--tv-fg-muted); max-width: 42ch; }

/* BEFORE / AFTER */
.compare { padding: calc(var(--tv-space-unit) * 16) calc(var(--tv-space-unit) * 4); max-width: 72rem; margin: 0 auto; }
.compare h2 { font-family: var(--tv-font-heading); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: calc(var(--tv-space-unit) * 3); }
.compare-intro { color: var(--tv-fg-muted); max-width: 40ch; margin-bottom: calc(var(--tv-space-unit) * 10); }
.compare-grid { display: grid; grid-template-columns: 1fr; gap: calc(var(--tv-space-unit) * 8); }
@media (min-width: 700px) { .compare-grid { grid-template-columns: 1fr 1fr; } }
.compare-grid .plate-frame { border: var(--tv-border-width) solid var(--tv-border); padding: calc(var(--tv-space-unit) * 3); background: var(--tv-surface); }
.compare-grid .plate-window { display: block; overflow: hidden; }
.compare-grid .plate-window img {
  width: 100%; height: auto; object-fit: contain; display: block;
  /* CRITICAL: reset the hero's blur/skew filter that cascades in from
     .plate-window img. Without this, the compare images inherit the
     degraded look permanently (no toggle to swap it out). */
  filter: none;
  transform: none;
  image-rendering: -webkit-optimize-contrast;
}
/* Mobile: constrain image width so fine text stays sharp — allow tap-to-zoom via padding */
@media (max-width: 699px) {
  .compare-grid { gap: calc(var(--tv-space-unit) * 6); }
  .fig-before, .fig-after { max-width: 24rem; margin-inline: auto; }
}
/* Desktop: side-by-side, slightly tighter */
@media (min-width: 700px) {
  .compare-grid .plate-window img { max-width: 100%; }
}
figcaption { font-family: var(--tv-font-mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--tv-fg-muted); margin-top: calc(var(--tv-space-unit) * 2); }
.fig-tag { display: block; text-align: center; font-family: var(--tv-font-heading); font-weight: 600; font-size: 1rem; margin-bottom: calc(var(--tv-space-unit) * 2); font-variant-caps: small-caps; letter-spacing: 0.15em; }
.fig-before .fig-tag { color: var(--tv-fg-muted); }
.fig-after .fig-tag { color: var(--tv-accent-2); }

/* VALUE PROPS — staggered */
.values { padding: calc(var(--tv-space-unit) * 16) calc(var(--tv-space-unit) * 4); background: var(--tv-surface); border-top: var(--tv-border-width) solid var(--tv-border); border-bottom: var(--tv-border-width) solid var(--tv-border); }
.values-inner { max-width: 72rem; margin: 0 auto; }
.values .section-label { margin-bottom: calc(var(--tv-space-unit) * 8); }
.claims-grid { display: grid; grid-template-columns: 1fr; gap: calc(var(--tv-space-unit) * 6); }
@media (min-width: 700px) { .claims-grid { grid-template-columns: repeat(3, 1fr); gap: calc(var(--tv-space-unit) * 5); } }
.claim { border-top: calc(var(--tv-border-width) * 3) solid var(--tv-accent); padding: calc(var(--tv-space-unit) * 4) 0 0; }
.claim-num { display: block; font-family: var(--tv-font-mono); font-size: 0.75rem; letter-spacing: 0.15em; color: var(--tv-accent); margin-bottom: calc(var(--tv-space-unit) * 3); }
.claim h3 { font-family: var(--tv-font-heading); font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 600; margin-bottom: calc(var(--tv-space-unit) * 3); }
.claim p { color: var(--tv-fg-muted); font-size: 0.95rem; }


.pricing-cta {
  padding: calc(var(--tv-space-unit) * 16) calc(var(--tv-space-unit) * 4);
  text-align: center;
}
.pricing-cta-inner {
  max-width: 42rem; margin: 0 auto;
}
.pricing-cta .section-label {
  margin-bottom: calc(var(--tv-space-unit) * 4);
}
.pricing-line {
  font-family: var(--tv-font-heading); font-size: 1.15rem; font-weight: 500; color: var(--tv-fg-muted);
  display: flex; align-items: center; justify-content: center; gap: calc(var(--tv-space-unit) * 3);
  margin-bottom: calc(var(--tv-space-unit) * 8);
}
.pricing-line strong {
  font-size: 2.5rem; font-weight: 700; color: var(--tv-accent); display: inline-block;
}
.pricing-cta-heading {
  font-family: var(--tv-font-heading); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700;
  letter-spacing: -0.01em; margin-bottom: calc(var(--tv-space-unit) * 6); max-width: 22ch;
  margin-left: auto; margin-right: auto; color: var(--tv-fg);
}


.footer {
  padding: calc(var(--tv-space-unit) * 8) calc(var(--tv-space-unit) * 4);
  display: flex; justify-content: space-between;
  max-width: 72rem; margin: 0 auto;
  border-top: var(--tv-border-width) solid var(--tv-border);
  font-size: 0.85rem; color: var(--tv-fg-muted);
  background: var(--tv-bg);
}
.footer a { color: var(--tv-fg-muted); }
.footer a:hover { color: var(--tv-accent); }
.footer a:focus-visible { outline: 2px solid var(--tv-accent); outline-offset: 4px; }

/* REDUCED MOTION */
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

<script>
/* ─────────────────────────────────────────────────────────────
   HERO — vertical split-screen before/after wipe slider
   - LEFT  = clean/restored (AFTER)  — top layer, clipped from right
   - RIGHT = degraded        (BEFORE) — bottom layer, shows through
   Pointer Events API → unified mouse + touch dragging.
   Auto-play: ease from 0% → 50% on load (respects reduced-motion).
   ───────────────────────────────────────────────────────────── */
(function () {
  const root = document.getElementById('baSlider');
  if (!root) return;
  const win      = root.querySelector('.ba-window');
  const clean    = root.querySelector('.ba-img--clean');
  const divider  = root.querySelector('.ba-divider');
  if (!win || !clean || !divider) return;

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // pos is the clean-layer coverage in % (0 = all before, 100 = all after).
  let pos = 0;
  let dragging = false;
  let settled = false;   // becomes true once auto-play finishes

  const clamp = (v) => Math.max(0, Math.min(100, v));

  function apply(p) {
    pos = clamp(p);
    // inset(top right bottom left): hide everything to the RIGHT of the divider.
    clean.style.clipPath = `inset(0 ${100 - pos}% 0 0)`;
    divider.style.left = pos + '%';
    root.setAttribute('data-pos', String(Math.round(pos)));
    divider.setAttribute('aria-valuenow', String(Math.round(pos)));
  }

  // ── pointer position → percentage ────────────────────────────
  function pctFromEvent(e) {
    const r = win.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width;
    return clamp(x * 100);
  }

  // ── drag lifecycle ───────────────────────────────────────────
  function startDrag(e) {
    dragging = true;
    win.setPointerCapture && e.pointerId !== undefined &&
      win.setPointerCapture(e.pointerId);
    divider.classList.add('is-dragging');
    // jump immediately to where the pointer landed
    apply(pctFromEvent(e));
    e.preventDefault();
  }
  function moveDrag(e) {
    if (!dragging) return;
    apply(pctFromEvent(e));
  }
  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    divider.classList.remove('is-dragging');
  }

  // Use pointer events on the whole window so the user can grab anywhere,
  // not just the thin 2px divider (much friendlier on touch).
  win.addEventListener('pointerdown', (e) => {
    // Once settled, any press starts a drag at the press point.
    if (settled) startDrag(e);
  });
  win.addEventListener('pointermove', moveDrag);
  win.addEventListener('pointerup', endDrag);
  win.addEventListener('pointercancel', endDrag);
  win.addEventListener('lostpointercapture', endDrag);

  // Keyboard accessibility on the divider button.
  divider.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 4;
    if (e.key === 'ArrowLeft')  { settled = true; apply(pos - step); e.preventDefault(); }
    if (e.key === 'ArrowRight') { settled = true; apply(pos + step); e.preventDefault(); }
    if (e.key === 'Home')       { settled = true; apply(0);   e.preventDefault(); }
    if (e.key === 'End')        { settled = true; apply(100); e.preventDefault(); }
  });

  // Prevent native image drag ghost.
  win.querySelectorAll('img').forEach(img =>
    img.addEventListener('dragstart', e => e.preventDefault()));

  // ── auto-play wipe (0 → 50%) ─────────────────────────────────
  function autoplay() {
    apply(0);
    settled = false;

    if (prefersReduced) {
      // Honour reduced-motion: land directly on the comparison view.
      apply(50);
      settled = true;
      return;
    }

    const TARGET = 50;
    const DURATION = 2200;           // ms — a deliberate, museum-paced sweep
    const t0 = performance.now();

    // easeInOutQuad for a smooth settle
    const ease = (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    function tick(now) {
      const t = Math.min(1, (now - t0) / DURATION);
      apply(TARGET * ease(t));
      if (t < 1) {
        requestAnimationFrame(tick);
      } else {
        settled = true;
      }
    }
    requestAnimationFrame(tick);
  }

  // Kick off after layout + images have a frame to settle.
  // requestAnimationFrame twice ≈ "next paint".
  requestAnimationFrame(() => requestAnimationFrame(autoplay));
})();
</script>
